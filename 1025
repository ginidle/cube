{t:"12:00",title:"午餐：娘子家咖啡",d:"✅ 已訂位 12:00 用餐",tag:"用餐"},
{t:"13:00",title:"搭紅線到台北101／世貿站",d:"",tag:"捷運"},
{t:"13:10",title:"TICC 拿娃・fromis_9 演唱會打卡",d:"Tomorrow Glow 打卡展架（詳見下方 fromis_9 打卡點）",tag:"打卡"},
{t:"13:30",title:"搭紅線到東門，轉橘線到忠孝新生",d:"也可在忠孝新生走路前往華山",tag:"捷運"},
{t:"14:00",title:"華山1914 首爾插畫展",d:"東二館・展期 10/23–10/26",tag:"展覽"},
{t:"15:00",title:"回小巨蛋",d:"忠孝新生 → 橘線 → 松江南京 → 綠線 → 小巨蛋",tag:"捷運"},
{t:"18:00",title:"演唱會開始 🎶",d:"Day2：&TEAM、NCT WISH、櫻坂46、ATEEZ ＋ Cover Stage",tag:"演唱會"},
{t:"20:40",title:"演唱會結束・離場",d:"趕往台北車站",tag:"離場"},
{t:"21:11",title:"高鐵 861 次 台北 → 台中",d:"6車 6D／6E・全票×2・TWD 1,400",tag:"高鐵"},
{t:"21:50",title:"傳訊息通知家長 📱",d:"告知預計 22:15 抵達台中高鐵站，請家長出發",tag:"回家"},
{t:"22:15",title:"抵達台中",d:"",tag:"高鐵"},
{t:"22:20",title:"家長接送回草屯 🚗",d:"在台中高鐵站與家長會合",tag:"回家"}
];
var KEY="trip1025",state={};
try{state=JSON.parse(localStorage.getItem(KEY)||"{}")}catch(e){state={}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}
function render(){
  var list=document.getElementById("list"),h="",done=0,first=-1;
  items.forEach(function(it,i){
    var c=!!state[i];if(c)done++;else if(first<0)first=i;
    h+='<div class="item'+(c?' done':'')+(first===i?' now':'')+'" data-i="'+i+'">'
      +'<input type="checkbox" '+(c?'checked':'')+' aria-label="完成">'
      +'<div class="time">'+it.t+'</div><div class="body"><div class="t">'+it.title+'</div>'
      +'<div class="d"><span class="tag">'+it.tag+'</span>'+it.d+'</div></div></div>';
  });
  list.innerHTML=h;
  document.getElementById("fill").style.width=(done/items.length*100)+"%";
  document.getElementById("cnt").textContent=done+" / "+items.length+" 完成";
  document.getElementById("nxt").textContent=first>=0?"下一步："+items[first].t:"全部完成 🎉";
}
document.getElementById("list").addEventListener("click",function(e){
  if(e.target.tagName==="A")return;
  var el=e.target.closest(".item");if(!el)return;
  var i=el.getAttribute("data-i");
  state[i]=!state[i];save();render();
});
document.getElementById("reset").onclick=function(){if(confirm("確定重置？")){state={};save();render()}};
render();

document.getElementById("dl").onclick=async function(){
  var L=["Music Expo Live 2026 in Taipei - 10/25 (Sun) Day 2","地點：台北小巨蛋　開演：18:00　MC：櫻井翔","","【表演順序】"];
  var n=0;document.querySelectorAll(".order li").forEach(function(li){var s=li.classList.contains("sp");if(!s)n++;L.push((s?"★ ":n+". ")+li.textContent.replace(/\s+/g," ").trim())});
  L.push("","【應援影片】");
  document.querySelectorAll(".artist").forEach(function(a){
    L.push(a.querySelector("h3").textContent+":");
    a.querySelectorAll("a.l").forEach(function(x,i){L.push("  "+(i+1)+". "+x.href)});
  });
  L.push("","【當日行程】");
  items.forEach(function(it){L.push(it.t+"  "+it.title+(it.d&&it.d.indexOf("<")<0?"（"+it.d+"）":""))});
  try{
    var b=new Blob([L.join("\n")],{type:"text/plain"});
    var d=(typeof claude!=="undefined")?await claude.use("downloads"):null;
    if(!d){var u=URL.createObjectURL(b),k=document.createElement("a");k.href=u;k.download="concert-1025.txt";k.click();return}
    await d.save({filename:"concert-1025.txt",data:b});
  }catch(e){}
};

});
</script>
